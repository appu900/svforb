generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Region {
  IN
  US
  AU
}

enum PlatformRole {
  PLATFORM_ADMIN
  ORG_USER
  ORG_ADMIN
}

enum OrgRole {
  SUPER_ADMIN
  ORG_MEMBER
  ORG_ADMIN
}

enum SiteRole {
  SITE_ADMIN
  STAFF
  DRIVER
}

enum OrgType {
  BUSINESS_SINGLE
  BUSINESS_MULTI
  CHARITY
  CHARITY_SINGLE
  CHARITY_MULTI
}

enum VenueType {
  CAFE_RESTAURANT
  BAKERY
  GROCERY_STORE
  FOOD_TRUCK
  CATERING_SERVICE
  HOTEL
  WEDDING_VENUE
  CLOUD_KITCHEN
  OTHER
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum StorageType {
  NON_REFRIGERATED
  REFRIGERATED
  FROZEN
}

enum ListingStatus {
  ACTIVE
  PARTIAL
  CLAIMED
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  CONFIRMED
  COLLECTED
  CANCELLED
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String  @unique
  passwordHash String
  phoneNumber  String
  region       Region?

  platformRole PlatformRole @default(ORG_USER)

  emailVerified     Boolean   @default(false)
  emailverifyToken  String?
  emailVerifyExpiry DateTime?

  passwordResetToken  String?
  passwordResetExpiry DateTime?

  deviceToken String?
  isActive    Boolean @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orgMemeberShips OrgMemeberShip[]
  siteAccesses    siteAccess[]

  @@index([email])
  @@index([phoneNumber])
  @@index([region])
  @@map("users")
}

model TeamMember {
  id     Int @id @default(autoincrement())
  userId Int
}

model SubscriptionPlan {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  displayName    String
  maxSites       Int
  maxUserPerSite Int
  priceMonthly   Float
  priceAnnual    Float
  features       String[]
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organisations  Organisation[]

  @@map("subscription_plans")
}

model Organisation {
  id                   Int                @id @default(autoincrement())
  name                 String
  organizationType     OrgType
  region               Region?
  registrationNumber   String?
  address              String
  brandName            String?
  venueType            VenueType?
  logoUrl              String?
  subscriptionId       Int
  subscription         SubscriptionPlan   @relation(fields: [subscriptionId], references: [id])
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  billingCycle         BillingCycle       @default(MONTHLY)
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?

  latitude  Float?
  longitude Float?
  location  Unsupported("geography(Point, 4326)")?

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  orgMemeberShips      OrgMemeberShip[]
  siteAccesses         siteAccess[]
  charityPickupPrefs   CharityPickupPrefs?
  foodListings         FoodListing[]
  foodClaims           FoodClaim[]                @relation("CharityClaims")
  listingActivities    ListingActivity[]
  sportedByCharitiesup RestaurantCharitySupport[] @relation("RestaurantSupport")
  restaurantsSupported RestaurantCharitySupport[] @relation("CharitySupport")


  @@index([region])
  @@index([organizationType])
  @@index([subscriptionId])
  @@map("organisations")
}

model Site {
  id               Int                                    @id @default(autoincrement())
  organisationId   Int
  organisationName String
  address          String
  postcode         String?
  contactName      String
  contactEmail     String
  contactMobile    String
  latitude         Float?
  longitude        Float?
  location         Unsupported("geography(Point, 4326)")?
  isActive         Boolean                                @default(true)
  pickupRadiusKm   Int?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  siteAccesses siteAccess[]
  foodListings FoodListing[]

  @@index([organisationId])
  @@map("sites")
}

model OrgMemeberShip {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(ORG_MEMBER)
  joinedAt       DateTime     @default(now())

  @@unique([userId, organisationId])
  @@index([userId])
  @@map("org_membership")
}

model siteAccess {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  siteId                  Int
  organisationId          Int
  siteRole                SiteRole @default(STAFF)
  grantedAt               DateTime @default(now())
  grantedBy               Int
  canClaimPickupsDirectly Boolean  @default(false)

  user         User         @relation(fields: [userId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([userId, siteId])
  @@index([siteId, userId])
  @@index([userId])
  @@map("site_accesses")
}

model CharityPickupPrefs {
  id             Int          @id @default(autoincrement())
  organisationId Int          @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  radiusKm       Int          @default(5)
  postCode       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("charity_pickup_prefs")
}

model FoodListing {
  id             Int          @id @default(autoincrement())
  siteId         Int
  site           Site         @relation(fields: [siteId], references: [id])
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  foodItems      Json
  totalQtyKg     Float
  remainingQtyKg Float

  pickupAddress  String
  pickupPostcode String?
  pickupLat      Float
  pickupLng      Float

  bestBefore     DateTime
  pickupFromTime DateTime?
  pickupByTime   DateTime?

  needsRefrigeration Boolean @default(false)
  needsReheating     Boolean @default(false)
  containsAllergens  Boolean @default(false)
  isGlutenFree       Boolean @default(false)
  isSafeForDonation  Boolean @default(true)

  photoUrls String[]      @default([])
  status    ListingStatus @default(ACTIVE)

  relistOfId   Int?
  relistOf     FoodListing?  @relation("RelistChain", fields: [relistOfId], references: [id])
  foodListings FoodListing[] @relation("RelistChain")

  uniqueCharityCount Int @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  foodClaims        FoodClaim[]
  listingActivities ListingActivity[]

  @@index([siteId])
  @@index([organisationId])
  @@index([status])
  @@index([bestBefore])
  @@index([pickupPostcode])
  @@map("food_listings")
}

model FoodClaim {
  id           Int          @id @default(autoincrement())
  listingId    Int
  listing      FoodListing  @relation(fields: [listingId], references: [id])
  charityOrgId Int
  chairtyOrg   Organisation @relation("CharityClaims", fields: [charityOrgId], references: [id])
  claimedItems Json
  claimedQtyKg Float
  isFullClaim  Boolean      @default(false)
  status       ClaimStatus  @default(PENDING)

  rating     Int?
  ratingNote String?

  collectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listingId])
  @@index([charityOrgId])
  @@index([status])
  @@map("food_claims")
}

model ListingActivity {
  id         Int          @id @default(autoincrement())
  listingId  Int
  listing    FoodListing  @relation(fields: [listingId], references: [id])
  actorOrgId Int
  actorOrg   Organisation @relation(fields: [actorOrgId], references: [id])
  eventType  String
  message    String
  qtyKg      Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([listingId])
  @@index([actorOrgId])
  @@index([createdAt])
  @@map("listing_activity")
}

model RestaurantCharitySupport {
  id              Int          @id @default(autoincrement())
  restaurantOrgId Int
  restaurantOrg   Organisation @relation("RestaurantSupport", fields: [restaurantOrgId], references: [id])
  charityOrgId    Int
  charityOrg      Organisation @relation("CharitySupport", fields: [charityOrgId], references: [id])

  firstClaimedAt DateTime @default(now())
  lastClaimedAt  DateTime @default(now())

  totalClaimsCount Int @default(1)

  @@unique([restaurantOrgId, charityOrgId])
  @@index([restaurantOrgId])
  @@index([charityOrgId])
  @@map("restaurant_charity_support")
}
