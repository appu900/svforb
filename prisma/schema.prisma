generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Region {
  IN
  US
  AU
}

enum PlatformRole {
  PLATFORM_ADMIN
  ORG_USER
  ORG_ADMIN
}

enum OrgRole {
  SUPER_ADMIN
  ORG_MEMBER
  ORG_ADMIN
}

enum SiteRole {
  SITE_ADMIN
  STAFF
  DRIVER
}

enum OrgType {
  BUSINESS_SINGLE
  BUSINESS_MULTI
  CHARITY
  CHARITY_SINGLE
  CHARITY_MULTI
  FARMER_PRODUCER
  FARMER_CONSUMER
}

enum VenueType {
  CAFE_RESTAURANT
  BAKERY
  CATERER
  GROCERY_STORE
  FOOD_TRUCK
  CATERING_SERVICE
  HOTEL
  WEDDING_VENUE
  CLOUD_KITCHEN
  FARM
  OTHER
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum StorageType {
  NON_REFRIGERATED
  REFRIGERATED
  FROZEN
}

enum ListingStatus {
  ACTIVE
  PARTIAL
  CLAIMED
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  CONFIRMED
  COLLECTED
  CANCELLED
}

enum ClaimMode {
  FULL
  PARTIAL
}

enum DriverPickupStatus {
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COLLECTED
  CANCELLED
}

enum FoodListingType {
  HUMAN
  ANIMAL
  BOTH
}

enum TokenPlatform {
  IOS
  ANDROID
}

enum TokenType {
  APNS
  FCM
  EXPO
}

enum TokenTargetApp {
  BUSINESS
  DRIVER
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String  @unique
  passwordHash String
  phoneNumber  String
  region       Region?

  platformRole PlatformRole @default(ORG_USER)

  emailVerified     Boolean   @default(false)
  emailverifyToken  String?
  emailVerifyExpiry DateTime?

  passwordResetToken  String?
  passwordResetExpiry DateTime?

  deviceToken String?
  isActive    Boolean @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orgMemeberShips OrgMemeberShip[]
  siteAccesses    siteAccess[]
  driverPickups  DriverPickup[] @relation("DriverPickups")
  deviceTokens   DeviceToken[]

  @@index([email])
  @@index([phoneNumber])
  @@index([region])
  @@map("users")
}

model TeamMember {
  id     Int @id @default(autoincrement())
  userId Int
}

model SubscriptionPlan {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  displayName      String
  maxSites         Int
  maxUserPerSite   Int
  priceMonthly     Float
  priceAnnual      Float
  features         String[]
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orgSubscriptions OrgSubscription[]

  @@map("subscription_plans")
}

model Organisation {
  id                 Int        @id @default(autoincrement())
  name               String
  organizationType   OrgType
  region             Region?
  registrationNumber String?
  address            String
  brandName          String?
  venueType          VenueType?
  logoUrl            String?

  latitude  Float?
  longitude Float?
  location  Unsupported("geography(Point, 4326)")?

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  subscription         OrgSubscription?
  orgMemeberShips      OrgMemeberShip[]
  siteAccesses         siteAccess[]
  charityPickupPrefs   CharityPickupPrefs?
  foodListings         FoodListing[]
  foodClaims           FoodClaim[]                @relation("CharityClaims")
  listingActivities    ListingActivity[]
  sportedByCharitiesup RestaurantCharitySupport[] @relation("RestaurantSupport")
  restaurantsSupported RestaurantCharitySupport[] @relation("CharitySupport")

  @@index([region])
  @@index([organizationType])
  @@map("organisations")
}

model OrgSubscription {
  id             Int              @id @default(autoincrement())
  organisationId Int              @unique
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planId         Int
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  status               SubscriptionStatus @default(TRIALING)
  billingCycle         BillingCycle       @default(MONTHLY)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([status])
  @@map("org_subscriptions")
}

model Site {
  id               Int                                    @id @default(autoincrement())
  organisationId   Int
  organisationName String
  address          String
  postcode         String?
  contactName      String
  contactEmail     String
  contactMobile    String
  latitude         Float?
  longitude        Float?
  location         Unsupported("geography(Point, 4326)")?
  isActive         Boolean                                @default(true)
  pickupRadiusKm   Int?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  siteAccesses      siteAccess[]
  foodListings      FoodListing[]
  siteNotifications SiteNotification[]

  @@index([organisationId])
  @@map("sites")
}

model OrgMemeberShip {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(ORG_MEMBER)
  joinedAt       DateTime     @default(now())

  @@unique([userId, organisationId])
  @@index([userId])
  @@map("org_membership")
}

model siteAccess {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  siteId                  Int
  organisationId          Int
  siteRole                SiteRole @default(STAFF)
  grantedAt               DateTime @default(now())
  grantedBy               Int
  canClaimPickupsDirectly Boolean  @default(false)

  user         User         @relation(fields: [userId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([userId, siteId])
  @@index([siteId, userId])
  @@index([userId])
  @@map("site_accesses")
}

model CharityPickupPrefs {
  id             Int          @id @default(autoincrement())
  organisationId Int          @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  radiusKm       Int          @default(5)
  postCode       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("charity_pickup_prefs")
}

model FoodListing {
  id             Int          @id @default(autoincrement())
  siteId         Int
  site           Site         @relation(fields: [siteId], references: [id])
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  listingType    FoodListingType @default(HUMAN)
  totalQtyKg     Float
  remainingQtyKg Float

  pickupAddress  String
  pickupPostcode String?
  pickupLat      Float
  pickupLng      Float

  bestBefore     DateTime
  pickupFromTime DateTime?
  pickupByTime   DateTime?

  needsRefrigeration Boolean  @default(false)
  needsAmbient       Boolean  @default(false)
  needsFreezer       Boolean  @default(false)
  needsReheating     Boolean  @default(false)
  isSafeForDonation  Boolean  @default(true)
  allergens          String[] @default([])

  photoUrls String[]      @default([])
  status    ListingStatus @default(ACTIVE)

  relistOfId   Int?
  relistOf     FoodListing?  @relation("RelistChain", fields: [relistOfId], references: [id])
  foodListings FoodListing[] @relation("RelistChain")

  uniqueClaimantCount Int @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  foodItems         FoodItem[]
  foodClaims        FoodClaim[]
  listingActivities ListingActivity[]
  driverPickups     DriverPickup[]
  siteNotifications SiteNotification[]

  @@index([siteId])
  @@index([organisationId])
  @@index([status])
  @@index([bestBefore])
  @@index([pickupPostcode])
  @@map("food_listings")
}

model FoodItem {
  id             Int         @id @default(autoincrement())
  listingId      Int
  listing        FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name           String
  totalQtyKg     Float
  remainingQtyKg Float
  unit           String?
  category       String?

  claimItems ClaimItem[]

  @@index([listingId])
  @@map("food_items")
}

model FoodClaim {
  id           Int          @id @default(autoincrement())
  listingId    Int
  listing      FoodListing  @relation(fields: [listingId], references: [id])
  claimantOrgId Int
  claimantOrg   Organisation @relation("CharityClaims", fields: [claimantOrgId], references: [id])
  claimMode     ClaimMode   @default(PARTIAL)
  status        ClaimStatus @default(PENDING)

  rating     Int?
  ratingNote String?

  confirmedAt DateTime?
  collectedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  claimItems  ClaimItem[]
  driverPickups DriverPickup[]

  @@index([listingId])
  @@index([claimantOrgId])
  @@index([status])
  @@map("food_claims")
}

model ClaimItem {
  id         Int       @id @default(autoincrement())
  claimId    Int
  claim      FoodClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  foodItemId Int
  foodItem   FoodItem  @relation(fields: [foodItemId], references: [id])
  qtyKg      Float

  @@index([claimId])
  @@index([foodItemId])
  @@map("claim_items")
}

model ListingActivity {
  id         Int          @id @default(autoincrement())
  listingId  Int
  listing    FoodListing  @relation(fields: [listingId], references: [id])
  actorOrgId Int
  actorOrg   Organisation @relation(fields: [actorOrgId], references: [id])
  eventType  String
  message    String
  qtyKg      Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([listingId])
  @@index([actorOrgId])
  @@index([createdAt])
  @@map("listing_activity")
}

model RestaurantCharitySupport {
  id              Int          @id @default(autoincrement())
  restaurantOrgId Int
  restaurantOrg   Organisation @relation("RestaurantSupport", fields: [restaurantOrgId], references: [id])
  charityOrgId    Int
  charityOrg      Organisation @relation("CharitySupport", fields: [charityOrgId], references: [id])

  firstClaimedAt DateTime @default(now())
  lastClaimedAt  DateTime @default(now())

  totalClaimsCount Int @default(1)

  @@unique([restaurantOrgId, charityOrgId])
  @@index([restaurantOrgId])
  @@index([charityOrgId])
  @@map("restaurant_charity_support")
}

model SiteAnalytics {
  id     Int @id @default(autoincrement())
  siteId Int
}

model DriverPickup {
  id        Int                @id @default(autoincrement())
  driverId  Int
  driver    User               @relation("DriverPickups", fields: [driverId], references: [id])
  claimId   Int
  claim     FoodClaim          @relation(fields: [claimId], references: [id])
  listingId Int
  listing   FoodListing        @relation(fields: [listingId], references: [id])
  status    DriverPickupStatus @default(ACCEPTED)

  photoUrl         String?
  completionNotes  String?
  restaurantRating Int?

  acceptedAt  DateTime  @default(now())
  arrivedAt   DateTime?
  collectedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([claimId])
  @@index([listingId])
  @@index([status])
  @@map("driver_pickups")
}

model DeviceToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String        @unique
  platform  TokenPlatform
  tokenType TokenType
  tokenMode String        @default("prod")

  appVersion String?
  appBuild   String?
  appBundle  String?
  targetApp  TokenTargetApp @default(BUSINESS)

  isActive           Boolean   @default(true)
  failureCount       Int       @default(0)
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  deactivationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([userId, isActive, targetApp])
  @@index([isActive])
  @@map("device_tokens")
}

model NotificationRecord {
  id    Int    @id @default(autoincrement())
  title String
  body  String
  data  Json?

  channel        String  @default("push")
  deepLink       String?
  imageUrl       String?
  status         String  @default("queued")
  priority       String  @default("normal")
  priorityWeight Int     @default(1)

  targetUserIds  Int[]    @default([])
  isBroadcast    Boolean  @default(false)
  targetPlatform String   @default("all")

  totalTargets Int @default(0)
  successCount Int @default(0)
  failureCount Int @default(0)

  failedTokens String[] @default([])
  lastError    String?
  completedAt  DateTime?
  scheduledAt  DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("notification_records")
}

model SiteNotification {
  id        Int         @id @default(autoincrement())
  siteId    Int
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  listingId Int
  listing   FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String      @default("new_listing_nearby")
  isRead    Boolean     @default(false)
  readAt    DateTime?
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@unique([siteId, listingId])
  @@index([siteId, expiresAt])
  @@index([siteId, isRead])
  @@index([listingId])
  @@map("site_notifications")
}





