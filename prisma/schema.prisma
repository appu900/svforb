generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Region {
  IN
  US
  AU
}

enum PlatformRole {
  PLATFORM_ADMIN
  ORG_USER
  ORG_ADMIN
}

enum OrgRole {
  SUPER_ADMIN
  ORG_MEMBER
  ORG_ADMIN
}

enum SiteRole {
  SITE_ADMIN
  STAFF
  DRIVER
}

enum OrgType {
  BUSINESS_SINGLE
  BUSINESS_MULTI
  CHARITY
  CHARITY_SINGLE
  CHARITY_MULTI
  FARMER_PRODUCER
  FARMER_CONSUMER
}

enum VenueType {
  CAFE_RESTAURANT
  BAKERY
  CATERER
  GROCERY_STORE
  FOOD_TRUCK
  CATERING_SERVICE
  HOTEL
  WEDDING_VENUE
  CLOUD_KITCHEN
  FARM
  PRODUCE_MARKET_GARDEN
  LIVESTOCK_FARM
  MIXED_FARM
  ORCHARD
  PROCESSING_FACILITY
  OTHER

}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum EnterpriseLocationBand {
  BAND_10_25
  BAND_26_50
  BAND_51_100
  BAND_100_PLUS
}

enum EnterpriseContactWindow {
  ASAP
  MORNING
  AFTERNOON
  ANY_TIME
}

enum EnterpriseEnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

/// What an Enterprise user may DO. Orthogonal to their scope, which decides
/// which slice of the Enterprise they may see.
enum EnterpriseRole {
  SUPER_ADMIN
  REPORTING_USER
  GROUP_ADMIN
  CLUSTER_ADMIN
  SITE_ADMIN
  SITE_USER
}

enum ScopeType {
  ENTERPRISE
  GROUP
  CLUSTER
  TERRITORY
  SITE
}

enum StorageType {
  NON_REFRIGERATED
  REFRIGERATED
  FROZEN
}

enum ListingStatus {
  ACTIVE
  PARTIAL
  CLAIMED
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  CONFIRMED
  COLLECTED
  CANCELLED
}

enum ClaimMode {
  FULL
  PARTIAL
}

enum DriverPickupStatus {
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COLLECTED
  CANCELLED
}

enum FoodListingType {
  HUMAN
  ANIMAL
  BOTH
}

enum TokenPlatform {
  IOS
  ANDROID
}

enum TokenType {
  APNS
  FCM
  EXPO
}

enum TokenTargetApp {
  BUSINESS
  DRIVER
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String  @unique
  passwordHash String
  phoneNumber  String
  region       Region?

  platformRole PlatformRole @default(ORG_USER)

  emailVerified     Boolean   @default(false)
  emailverifyToken  String?
  emailVerifyExpiry DateTime?

  passwordResetToken  String?
  passwordResetExpiry DateTime?

  deviceToken String?
  isActive    Boolean   @default(true)
  /// null means the invite has never been used — surfaces as INVITED
  lastLoginAt DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orgMemeberShips OrgMemeberShip[]
  siteAccesses    siteAccess[]
  driverPickups  DriverPickup[] @relation("DriverPickups")
  deviceTokens   DeviceToken[]
  userScopes     UserScope[]

  @@index([email])
  @@index([phoneNumber])
  @@index([region])
  @@map("users")
}

model TeamMember {
  id     Int @id @default(autoincrement())
  userId Int
}

model SubscriptionPlan {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  displayName String
  description String?

  /// null means unlimited (Enterprise)
  maxSites Int?
  /// null means unlimited (Multi Site, Enterprise)
  maxUserPerSite Int?

  /// null when pricing is bespoke — see contactSalesOnly
  priceMonthly Float?
  priceAnnual  Float?
  /// Base/default currency, used for any region without its own pricing
  currency String @default("AUD")

  /// India (region = IN) is billed in INR. Held on the same Stripe Price via
  /// currency_options, so there is still only one price id per billing cycle.
  priceMonthlyInr Float?
  priceAnnualInr  Float?

  /// Multi Site bills per location; the Stripe subscription quantity tracks site count
  isPerSite Boolean @default(false)

  /// Enterprise is not purchasable — the client routes to an enquiry form instead
  contactSalesOnly Boolean @default(false)

  stripeProductId      String?
  stripePriceIdMonthly String?
  stripePriceIdAnnual  String?

  /// Org types this plan is offered to
  applicableOrgTypes OrgType[]

  /// Bullet list rendered on the plan card
  features String[]

  /// Backs the "Includes everything in <plan>, plus:" line
  inheritsFromId Int?
  inheritsFrom   SubscriptionPlan?  @relation("PlanInheritance", fields: [inheritsFromId], references: [id])
  inheritedBy    SubscriptionPlan[] @relation("PlanInheritance")

  isMostPopular Boolean @default(false)
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planFeatures         PlanFeature[]
  orgSubscriptions     OrgSubscription[]
  pendingSubscriptions OrgSubscription[] @relation("PendingPlanChange")

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

/// Rows of the "Compare plans" grid. One row per plan per feature.
model PlanFeature {
  id     Int              @id @default(autoincrement())
  planId Int
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// Stable slug for code-level entitlement checks — `label` is display text and may change
  key      String
  category String
  label    String
  /// false renders as an em dash in the grid
  included Boolean @default(true)
  /// Replaces the tick with text, e.g. "Up to 6" on the Users row
  value     String?
  sortOrder Int     @default(0)

  @@unique([planId, key])
  @@index([planId, sortOrder])
  @@map("plan_features")
}

model Organisation {
  id                 Int        @id @default(autoincrement())
  name               String
  organizationType   OrgType
  region             Region?
  registrationNumber String?
  address            String
  brandName          String?
  venueType          VenueType?
  logoUrl            String?

  latitude  Float?
  longitude Float?
  location  Unsupported("geography(Point, 4326)")?

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  /// Stamped the first time this org starts the 30-day trial — enforces once per organisation
  freeTrialUsedAt DateTime?

  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  subscription         OrgSubscription?
  enterpriseEnquiries  EnterpriseEnquiry[]
  payments             Payment[]
  enterpriseGroups     EnterpriseGroup[]
  clusters             Cluster[]
  territories          Territory[]
  enterpriseContract   EnterpriseContract?
  enterpriseInvoices   EnterpriseInvoice[]
  userScopes           UserScope[]
  orgMemeberShips      OrgMemeberShip[]
  siteAccesses         siteAccess[]
  charityPickupPrefs   CharityPickupPrefs?
  foodListings         FoodListing[]
  foodClaims           FoodClaim[]                @relation("CharityClaims")
  listingActivities    ListingActivity[]
  sportedByCharitiesup RestaurantCharitySupport[] @relation("RestaurantSupport")
  restaurantsSupported RestaurantCharitySupport[] @relation("CharitySupport")

  @@index([region])
  @@index([organizationType])
  @@map("organisations")
}

model OrgSubscription {
  id             Int              @id @default(autoincrement())
  organisationId Int              @unique
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planId         Int
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// Billed site count for per-site plans (Multi Site); always 1 otherwise
  quantity Int @default(1)

  /// Set when the user cancels but keeps access until the period ends
  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?

  /// A downgrade waits for the current period to close. These mirror the Stripe
  /// Subscription Schedule so the client can show what is coming without a
  /// round trip to Stripe.
  pendingPlanId            Int?
  pendingPlan              SubscriptionPlan? @relation("PendingPlanChange", fields: [pendingPlanId], references: [id])
  pendingBillingCycle      BillingCycle?
  pendingChangeEffectiveAt DateTime?
  stripeScheduleId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@map("org_subscriptions")
}

/// Lead capture from the Enterprise flow.
model EnterpriseEnquiry {
  id             Int           @id @default(autoincrement())
  organisationId Int?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  firstName    String
  lastName     String
  businessName String
  businessType String
  mobile       String

  locationBand  EnterpriseLocationBand
  contactWindow EnterpriseContactWindow
  message       String?

  status EnterpriseEnquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([organisationId])
  @@map("enterprise_enquiries")
}

/// Billing history, written from Stripe invoice webhooks.
model Payment {
  id             Int          @id @default(autoincrement())
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  stripeInvoiceId       String  @unique
  stripePaymentIntentId String?
  stripeSubscriptionId  String?

  /// Smallest currency unit (cents) — Stripe's native representation
  amountCents Int
  currency    String        @default("AUD")
  status      PaymentStatus @default(PENDING)

  description    String?
  hostedInvoiceUrl String?
  invoicePdfUrl    String?
  failureMessage   String?

  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, createdAt])
  @@index([status])
  @@map("payments")
}

/// Processed Stripe event IDs. Stripe retries aggressively, so every handler
/// checks this table first to stay idempotent.
model StripeWebhookEvent {
  id            Int      @id @default(autoincrement())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([type, processedAt])
  @@map("stripe_webhook_events")
}

model Site {
  id               Int                                    @id @default(autoincrement())
  organisationId   Int
  organisationName String
  address          String
  postcode         String?
  contactName      String
  contactEmail     String
  contactMobile    String
  latitude         Float?
  longitude        Float?
  location         Unsupported("geography(Point, 4326)")?
  isActive         Boolean                                @default(true)
  pickupRadiusKm   Int?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  siteAccesses      siteAccess[]
  foodListings      FoodListing[]
  foodClaims        FoodClaim[]        @relation("ClaimantSiteClaims")
  siteNotifications SiteNotification[]
  clusterSite       ClusterSite?
  territorySite     TerritorySite?

  @@index([organisationId])
  @@map("sites")
}

model OrgMemeberShip {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(ORG_MEMBER)
  /// Set only for organisations on the Enterprise plan
  enterpriseRole EnterpriseRole?
  joinedAt       DateTime     @default(now())

  @@unique([userId, organisationId])
  @@index([userId])
  @@map("org_membership")
}

model siteAccess {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  siteId                  Int
  organisationId          Int
  siteRole                SiteRole @default(STAFF)
  grantedAt               DateTime @default(now())
  grantedBy               Int
  canClaimPickupsDirectly Boolean  @default(false)

  user         User         @relation(fields: [userId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([userId, siteId])
  @@index([siteId, userId])
  @@index([userId])
  @@map("site_accesses")
}

model CharityPickupPrefs {
  id             Int          @id @default(autoincrement())
  organisationId Int          @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  radiusKm       Int          @default(5)
  postCode       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("charity_pickup_prefs")
}

model FoodListing {
  id             Int          @id @default(autoincrement())
  siteId         Int
  site           Site         @relation(fields: [siteId], references: [id])
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  listingType    FoodListingType @default(HUMAN)
  totalQtyKg     Float
  remainingQtyKg Float

  pickupAddress  String
  pickupPostcode String?
  pickupLat      Float
  pickupLng      Float

  bestBefore     DateTime
  pickupFromTime DateTime?
  pickupByTime   DateTime?

  needsRefrigeration Boolean  @default(false)
  needsAmbient       Boolean  @default(false)
  needsFreezer       Boolean  @default(false)
  needsHot           Boolean  @default(false)
  needsReheating     Boolean  @default(false)
  isSafeForDonation  Boolean  @default(true)
  allergens          String[] @default([])

  photoUrls String[]      @default([])
  status    ListingStatus @default(ACTIVE)

  relistOfId   Int?
  relistOf     FoodListing?  @relation("RelistChain", fields: [relistOfId], references: [id])
  foodListings FoodListing[] @relation("RelistChain")

  uniqueClaimantCount Int @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  foodItems         FoodItem[]
  foodClaims        FoodClaim[]
  listingActivities ListingActivity[]
  driverPickups     DriverPickup[]
  siteNotifications SiteNotification[]

  /// Enterprise classification stamped at creation. Reassigning a site later
  /// must never rewrite past reporting, so these carry no foreign keys.
  snapshotGroupId     Int?
  snapshotClusterId   Int?
  snapshotTerritoryId Int?

  @@index([siteId])
  @@index([organisationId])
  @@index([status])
  @@index([bestBefore])
  @@index([snapshotGroupId])
  @@index([snapshotClusterId])
  @@index([snapshotTerritoryId])
  @@index([pickupPostcode])
  @@index([status], map: "food_listings_active_idx", where: raw("(status = ANY (ARRAY['ACTIVE'::\"ListingStatus\", 'PARTIAL'::\"ListingStatus\"]))"))
  @@map("food_listings")
}

model FoodItem {
  id             Int         @id @default(autoincrement())
  listingId      Int
  listing        FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name           String
  totalQtyKg     Float
  remainingQtyKg Float
  unit           String?
  category       String?

  claimItems ClaimItem[]

  @@index([listingId])
  @@map("food_items")
}

model FoodClaim {
  id            Int          @id @default(autoincrement())
  listingId     Int
  listing       FoodListing  @relation(fields: [listingId], references: [id])
  claimantOrgId Int
  claimantOrg   Organisation @relation("CharityClaims", fields: [claimantOrgId], references: [id])
  /** Charity/farmer site that made the claim (location admin). Null for legacy / head-office claims. */
  claimantSiteId Int?
  claimantSite   Site?       @relation("ClaimantSiteClaims", fields: [claimantSiteId], references: [id])
  claimMode     ClaimMode    @default(PARTIAL)
  status        ClaimStatus  @default(PENDING)

  rating     Int?
  ratingNote String?

  /** Listing provider (restaurant) confirmed the collection happened. */
  providerConfirmedAt  DateTime?
  /** Restaurant rates the claimant (charity / farmer). */
  providerRating       Int?
  providerRatingNote   String?
  /** true = restaurant says collection happened; false = dispute / no-show. */
  providerDidCollect   Boolean?

  confirmedAt DateTime?
  collectedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  claimItems  ClaimItem[]
  driverPickups DriverPickup[]

  /// Classification at claim time — see FoodListing for rationale.
  snapshotGroupId     Int?
  snapshotClusterId   Int?
  snapshotTerritoryId Int?

  @@index([listingId])
  @@index([claimantOrgId])
  @@index([claimantSiteId])
  @@index([status])
  @@index([snapshotGroupId])
  @@index([snapshotClusterId])
  @@index([snapshotTerritoryId])
  @@map("food_claims")
}

model ClaimItem {
  id         Int       @id @default(autoincrement())
  claimId    Int
  claim      FoodClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  foodItemId Int
  foodItem   FoodItem  @relation(fields: [foodItemId], references: [id])
  qtyKg      Float

  @@index([claimId])
  @@index([foodItemId])
  @@map("claim_items")
}

model ListingActivity {
  id         Int          @id @default(autoincrement())
  listingId  Int
  listing    FoodListing  @relation(fields: [listingId], references: [id])
  actorOrgId Int
  actorOrg   Organisation @relation(fields: [actorOrgId], references: [id])
  eventType  String
  message    String
  qtyKg      Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([listingId])
  @@index([actorOrgId])
  @@index([createdAt])
  @@map("listing_activity")
}

model RestaurantCharitySupport {
  id              Int          @id @default(autoincrement())
  restaurantOrgId Int
  restaurantOrg   Organisation @relation("RestaurantSupport", fields: [restaurantOrgId], references: [id])
  charityOrgId    Int
  charityOrg      Organisation @relation("CharitySupport", fields: [charityOrgId], references: [id])

  firstClaimedAt DateTime @default(now())
  lastClaimedAt  DateTime @default(now())

  totalClaimsCount Int @default(1)

  @@unique([restaurantOrgId, charityOrgId])
  @@index([restaurantOrgId])
  @@index([charityOrgId])
  @@map("restaurant_charity_support")
}

model SiteAnalytics {
  id     Int @id @default(autoincrement())
  siteId Int
}

model DriverPickup {
  id        Int                @id @default(autoincrement())
  driverId  Int
  driver    User               @relation("DriverPickups", fields: [driverId], references: [id])
  claimId   Int
  claim     FoodClaim          @relation(fields: [claimId], references: [id])
  listingId Int
  listing   FoodListing        @relation(fields: [listingId], references: [id])
  status    DriverPickupStatus @default(ACCEPTED)

  photoUrl         String?
  completionNotes  String?
  restaurantRating Int?

  acceptedAt  DateTime  @default(now())
  arrivedAt   DateTime?
  collectedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([claimId])
  @@index([listingId])
  @@index([status])
  @@map("driver_pickups")
}

model DeviceToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String        @unique
  platform  TokenPlatform
  tokenType TokenType
  tokenMode String        @default("prod")

  appVersion String?
  appBuild   String?
  appBundle  String?
  targetApp  TokenTargetApp @default(BUSINESS)

  isActive           Boolean   @default(true)
  failureCount       Int       @default(0)
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  deactivationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([userId, isActive, targetApp])
  @@index([isActive])
  @@map("device_tokens")
}

model NotificationRecord {
  id    Int    @id @default(autoincrement())
  title String
  body  String
  data  Json?

  channel        String  @default("push")
  deepLink       String?
  imageUrl       String?
  status         String  @default("queued")
  priority       String  @default("normal")
  priorityWeight Int     @default(1)

  targetUserIds  Int[]    @default([])
  isBroadcast    Boolean  @default(false)
  targetPlatform String   @default("all")

  totalTargets Int @default(0)
  successCount Int @default(0)
  failureCount Int @default(0)

  failedTokens String[] @default([])
  lastError    String?
  completedAt  DateTime?
  scheduledAt  DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("notification_records")
}

model SiteNotification {
  id        Int         @id @default(autoincrement())
  siteId    Int
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  listingId Int
  listing   FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String      @default("new_listing_nearby")
  isRead    Boolean     @default(false)
  readAt    DateTime?
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@unique([siteId, listingId])
  @@index([siteId, expiresAt])
  @@index([siteId, isRead])
  @@index([listingId])
  @@map("site_notifications")
}






// ═════════════════════════════════════════════════════════════════════════════
// ENTERPRISE
//
// An organisation is an Enterprise when its subscription plan is ENTERPRISE.
// Onboarding is unchanged — the org signs up normally, then a platform admin
// assigns the plan and records the offline contract.
//
// Structure is strictly nested: Group -> Cluster -> Site. Territory is a
// separate geographic dimension that cuts across the tree.
// ═════════════════════════════════════════════════════════════════════════════

/// Top reporting tier within an Enterprise, e.g. "Food & Beverages".
model EnterpriseGroup {
  id             Int          @id @default(autoincrement())
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name     String
  code     String?
  isActive Boolean @default(true)

  clusters Cluster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, name])
  @@index([organisationId, isActive])
  @@map("enterprise_groups")
}

/// A chain inside a group, e.g. "Taj Hotels". Always belongs to exactly one group.
model Cluster {
  id             Int          @id @default(autoincrement())
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  groupId Int
  group   EnterpriseGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  name     String
  code     String?
  isActive Boolean @default(true)

  clusterSites ClusterSite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, name])
  @@index([organisationId, isActive])
  @@index([groupId])
  @@map("clusters")
}

/// Site placement in the group tree. `siteId @unique` enforces strict nesting —
/// one cluster per site — while leaving the shared Site table untouched.
model ClusterSite {
  id        Int     @id @default(autoincrement())
  clusterId Int
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  siteId    Int     @unique
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy Int

  @@index([clusterId])
  @@map("cluster_sites")
}

/// Geographic dimension, independent of the group tree — a state can span
/// several clusters, so it cannot hang off Cluster.
model Territory {
  id             Int          @id @default(autoincrement())
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name     String
  code     String?
  isActive Boolean @default(true)

  territorySites TerritorySite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, name])
  @@index([organisationId, isActive])
  @@map("territories")
}

model TerritorySite {
  id          Int       @id @default(autoincrement())
  territoryId Int
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  siteId      Int       @unique
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy Int

  @@index([territoryId])
  @@map("territory_sites")
}

/// Negotiated with the platform admin and paid outside the app.
/// Invoice total = ratePerSiteCents x live site count at generation time.
model EnterpriseContract {
  id             Int          @id @default(autoincrement())
  organisationId Int          @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// 10000 = $100.00 per site
  ratePerSiteCents Int
  currency         String           @default("AUD")
  billingFrequency BillingFrequency @default(MONTHLY)

  /// Site count agreed at signing — reference only; invoices count live sites
  contractedSiteCount Int?

  /// GST/VAT applied by the invoice cron
  taxRatePercent Float @default(0)

  startDate        DateTime
  endDate          DateTime?
  status           ContractStatus @default(ACTIVE)
  paymentTermsDays Int            @default(30)

  /// Anchors the billing period; the cron advances it after each run
  nextInvoiceOn DateTime?

  notes     String?
  createdBy Int

  invoices EnterpriseInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextInvoiceOn])
  @@map("enterprise_contracts")
}

/// Generated on a schedule by the billing cron; marked paid by hand.
model EnterpriseInvoice {
  id             Int          @id @default(autoincrement())
  invoiceNumber  String       @unique
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contractId     Int
  contract       EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  periodStart DateTime
  periodEnd   DateTime

  /// Snapshot of what was billed — renegotiating the rate never alters history
  siteCount        Int
  ratePerSiteCents Int
  subtotalCents    Int
  taxCents         Int    @default(0)
  totalCents       Int
  currency         String

  status   InvoiceStatus @default(DRAFT)
  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  /// Platform admin who recorded the offline payment
  paidBy           Int?
  paymentReference String?
  notes            String?
  pdfUrl           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stops the cron double-invoicing if it fires twice
  @@unique([contractId, periodStart])
  @@index([organisationId, periodStart])
  @@index([status, dueAt])
  @@map("enterprise_invoices")
}

/// Which slice of the Enterprise a user may see. A user may hold several rows;
/// their effective reach is the union, resolved down to a set of site ids.
///
/// Role says what they can do. This says what they can see.
model UserScope {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  scopeType ScopeType
  /// null when scopeType is ENTERPRISE — the whole organisation
  scopeId Int?

  grantedAt DateTime @default(now())
  grantedBy Int

  @@unique([userId, scopeType, scopeId])
  @@index([userId])
  @@index([organisationId, scopeType])
  @@map("user_scopes")
}
